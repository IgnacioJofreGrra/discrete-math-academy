{
  "id": "module_init_0_foundations",
  "title": "Matematica Inicial 0: Fundamentos de Numeros Reales",
  "description": "Conjuntos numericos, propiedades operativas y potencias con exponente natural y entero.",
  "order": 0,
  "track": "initial",
  "difficulty": "beginner",
  "estimatedHours": 10,
  "icon": "book-open",
  "sections": [
    {
      "id": "section_init_0_1",
      "title": "Conjuntos numericos en R",
      "description": "Ubica N, Z, Q e I dentro de los numeros reales y entiende su relacion.",
      "order": 1,
      "content": {
        "theory": {
          "definition": "El conjunto de los numeros reales $\\mathbb{R}$ contiene a los racionales $\\mathbb{Q}$ y a los irracionales $\\mathbb{I}$. Dentro de $\\mathbb{Q}$ estan los enteros $\\mathbb{Z}$ y dentro de $\\mathbb{Z}$ los naturales $\\mathbb{N}$.",
          "notation": "$\\mathbb{N} \\subset \\mathbb{Z} \\subset \\mathbb{Q} \\subset \\mathbb{R}$, y ademas $\\mathbb{I} \\subset \\mathbb{R}$ con $\\mathbb{Q} \\cap \\mathbb{I} = \\emptyset$.",
          "examples": [
            {
              "text": "$5 \\in \\mathbb{N} \\subset \\mathbb{Z} \\subset \\mathbb{Q} \\subset \\mathbb{R}$.",
              "latex": "5 \\in \\mathbb{N} \\subset \\mathbb{Z} \\subset \\mathbb{Q} \\subset \\mathbb{R}"
            },
            {
              "text": "$-3 \\in \\mathbb{Z} \\subset \\mathbb{Q} \\subset \\mathbb{R}$, pero $-3 \\notin \\mathbb{N}$.",
              "latex": "-3 \\in \\mathbb{Z} \\subset \\mathbb{Q} \\subset \\mathbb{R}"
            },
            {
              "text": "$\\sqrt{2}$ y $\\pi$ son irracionales: pertenecen a $\\mathbb{I}$ y a $\\mathbb{R}$.",
              "latex": "\\sqrt{2}, \\pi \\in \\mathbb{I}"
            }
          ]
        },
        "para_que_sirve": {
          "title": "Para que sirve",
          "applications": [
            {
              "area": "Algebra basica",
              "description": "Permite elegir correctamente el conjunto donde trabajas y saber que propiedades puedes usar.",
              "example": "Si trabajas en $\\mathbb{N}$, no siempre existe opuesto aditivo; en $\\mathbb{Z}$ si existe."
            },
            {
              "area": "Modelado",
              "description": "Ayuda a distinguir cantidades discretas de magnitudes continuas.",
              "example": "Cantidad de alumnos: entero. Longitud: real."
            }
          ]
        },
        "exercises": [
          {
            "id": "exercise_init_0_1_1",
            "type": "flashcard",
            "question": "Que relacion de inclusion es correcta entre $\\mathbb{N}$, $\\mathbb{Z}$, $\\mathbb{Q}$ y $\\mathbb{R}$?",
            "answer": "$\\mathbb{N} \\subset \\mathbb{Z} \\subset \\mathbb{Q} \\subset \\mathbb{R}$. Cada conjunto esta contenido en el siguiente.",
            "difficulty": "easy"
          },
          {
            "id": "exercise_init_0_1_2",
            "type": "challenge",
            "title": "Clasificacion rapida",
            "problem": "Cual opcion clasifica correctamente a $\\sqrt{2}$?",
            "options": [
              {
                "value": "Pertenece a $\\mathbb{I}$ y a $\\mathbb{R}$, pero no a $\\mathbb{Q}$.",
                "correct": true,
                "explanation": "Correcto. $\\sqrt{2}$ es irracional, por lo tanto pertenece a $\\mathbb{I}$ y a $\\mathbb{R}$."
              },
              {
                "value": "Pertenece a $\\mathbb{Q}$ porque tiene decimales.",
                "correct": false,
                "explanation": "Incorrecto. Tener decimales no implica ser racional."
              },
              {
                "value": "Solo pertenece a $\\mathbb{N}$.",
                "correct": false,
                "explanation": "Incorrecto. $\\sqrt{2}$ no es natural."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exercise_init_0_1_3",
            "type": "step_by_step",
            "title": "Clasificar números en sus conjuntos",
            "steps": [
              {
                "instruction": "Clasifica: $0$. ¿A qué conjuntos pertenece?",
                "hint": "¿Es natural? ¿Entero? ¿Racional? ¿Real?",
                "answer": "$0\\in\\mathbb{N}\\subset\\mathbb{Z}\\subset\\mathbb{Q}\\subset\\mathbb{R}$."
              },
              {
                "instruction": "Clasifica: $-3$.",
                "hint": "¿Es no-negativo? ¿Es el cociente de dos enteros?",
                "answer": "$-3\\in\\mathbb{Z}\\subset\\mathbb{Q}\\subset\\mathbb{R}$, pero $-3\\notin\\mathbb{N}$."
              },
              {
                "instruction": "Clasifica: $\\frac{1}{2}$.",
                "hint": "¿Es entero? ¿Es racional?",
                "answer": "$\\frac{1}{2}\\in\\mathbb{Q}\\subset\\mathbb{R}$, pero $\\frac{1}{2}\\notin\\mathbb{Z}$ ni $\\mathbb{N}$."
              },
              {
                "instruction": "Clasifica: $\\sqrt{5}$.",
                "hint": "¿Puede escribirse como $p/q$ con enteros? Pista: $\\sqrt{5}$ es irracional.",
                "answer": "$\\sqrt{5}\\in\\mathbb{R}\\setminus\\mathbb{Q}$: es real pero irracional."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exercise_init_0_1_4",
            "type": "flashcard",
            "question": "¿Qué tienen en común $\\mathbb{N}$, $\\mathbb{Z}$, $\\mathbb{Q}$ y $\\mathbb{R}$?",
            "answer": "Todos son subconjuntos de $\\mathbb{R}$ y forman una cadena de inclusión: $\\mathbb{N}\\subset\\mathbb{Z}\\subset\\mathbb{Q}\\subset\\mathbb{R}$.",
            "difficulty": "easy"
          }
        ],
        "exam": [
          {
            "id": "exam_i0_1_1",
            "question": "¿A qué conjunto numérico pertenece $\\sqrt{2}$?",
            "options": [
              {
                "value": "a",
                "label": "$\\mathbb{R}\\setminus\\mathbb{Q}$ (irracionales)",
                "correct": true,
                "explanation": "$\\sqrt{2}$ no puede expresarse como cociente de enteros; es real irracional."
              },
              {
                "value": "b",
                "label": "$\\mathbb{Q}$",
                "correct": false,
                "explanation": "$\\sqrt{2}$ es irracional; no está en $\\mathbb{Q}$."
              },
              {
                "value": "c",
                "label": "$\\mathbb{Z}$",
                "correct": false,
                "explanation": "Los enteros no incluyen irracionales."
              },
              {
                "value": "d",
                "label": "$\\mathbb{N}$",
                "correct": false,
                "explanation": "Los naturales son enteros no negativos; $\\sqrt{2}\\approx1.414$ no es natural."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_1_2",
            "question": "¿Cuál afirmación sobre la contención de conjuntos numéricos es correcta?",
            "options": [
              {
                "value": "a",
                "label": "$\\mathbb{N}\\subset\\mathbb{Z}\\subset\\mathbb{Q}\\subset\\mathbb{R}$",
                "correct": true,
                "explanation": "Cada conjunto contiene al anterior; esta es la cadena de inclusiones estándar."
              },
              {
                "value": "b",
                "label": "$\\mathbb{Z}\\subset\\mathbb{N}\\subset\\mathbb{Q}\\subset\\mathbb{R}$",
                "correct": false,
                "explanation": "$\\mathbb{N}\\subset\\mathbb{Z}$, no al revés."
              },
              {
                "value": "c",
                "label": "$\\mathbb{Q}\\subset\\mathbb{Z}\\subset\\mathbb{N}\\subset\\mathbb{R}$",
                "correct": false,
                "explanation": "El orden es el inverso."
              },
              {
                "value": "d",
                "label": "$\\mathbb{R}\\subset\\mathbb{Q}$",
                "correct": false,
                "explanation": "$\\mathbb{Q}\\subset\\mathbb{R}$, no al revés."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_1_3",
            "question": "¿Pertenece $-5$ a $\\mathbb{N}$?",
            "options": [
              {
                "value": "a",
                "label": "No; $\\mathbb{N}=\\{0,1,2,3,\\ldots\\}$ contiene solo enteros no negativos",
                "correct": true,
                "explanation": "Los naturales no incluyen negativos."
              },
              {
                "value": "b",
                "label": "Sí, porque es un entero",
                "correct": false,
                "explanation": "Los enteros incluyen negativos, pero $\\mathbb{N}$ no."
              },
              {
                "value": "c",
                "label": "Sí, en algunas definiciones de $\\mathbb{N}$",
                "correct": false,
                "explanation": "En ninguna definición estándar $\\mathbb{N}$ incluye negativos."
              },
              {
                "value": "d",
                "label": "No, porque no es primo",
                "correct": false,
                "explanation": "La primalidad no es el criterio; la razón es que $\\mathbb{N}$ no incluye negativos."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_1_4",
            "question": "¿Es $\\frac{22}{7}$ un número racional?",
            "options": [
              {
                "value": "a",
                "label": "Sí, porque es el cociente de dos enteros",
                "correct": true,
                "explanation": "$\\mathbb{Q}=\\{p/q: p,q\\in\\mathbb{Z}, q\\neq0\\}$; $22/7$ cumple esto."
              },
              {
                "value": "b",
                "label": "No, porque es una aproximación de $\\pi$",
                "correct": false,
                "explanation": "$22/7\\neq\\pi$; $22/7$ es exactamente racional, aunque no es igual a $\\pi$."
              },
              {
                "value": "c",
                "label": "Sí, pero también es irracional",
                "correct": false,
                "explanation": "Un número no puede ser racional e irracional a la vez."
              },
              {
                "value": "d",
                "label": "No, porque su expansión decimal no termina",
                "correct": false,
                "explanation": "Los racionales pueden tener expansión decimal infinita pero periódica; $22/7=3.\\overline{142857}$."
              }
            ],
            "difficulty": "easy"
          }
        ]
      }
    },
    {
      "id": "section_init_0_2",
      "title": "Propiedades de la suma y del producto",
      "description": "Revisa conmutatividad, asociatividad, neutros e inversos en R.",
      "order": 2,
      "content": {
        "theory": {
          "definition": "Para $x$, $y$, $z$ reales: suma y producto son conmutativos y asociativos. Existen neutro aditivo $0$ y neutro multiplicativo $1$. Existe opuesto $-x$ para todo real $x$ y existe inverso multiplicativo $x^{-1}$ para $x \\neq 0$.",
          "examples": [
            {
              "text": "Conmutativa de la suma: $x + y = y + x$.",
              "latex": "x+y=y+x"
            },
            {
              "text": "Inverso aditivo: $x + (-x) = 0$.",
              "latex": "x+(-x)=0"
            },
            {
              "text": "Inverso multiplicativo: $x \\cdot x^{-1}=1$, con $x \\neq 0$.",
              "latex": "x\\cdot x^{-1}=1,\\ x\\neq 0"
            },
            {
              "text": "Regla de signos: $x(-y)=-(xy)$ y $(-x)(-y)=xy$.",
              "latex": "x(-y)=-(xy),\\ (-x)(-y)=xy"
            }
          ]
        },
        "para_que_sirve": {
          "title": "Para que sirve",
          "applications": [
            {
              "area": "Calculo algebraico",
              "description": "Estas propiedades justifican cada paso al simplificar expresiones.",
              "example": "Para reagrupar terminos usas asociatividad y conmutatividad."
            },
            {
              "area": "Resolucion de ecuaciones",
              "description": "El opuesto y el inverso permiten aislar variables.",
              "example": "De $5x=10$, multiplicas por $1/5$ para obtener $x=2$."
            }
          ]
        },
        "exercises": [
          {
            "id": "exercise_init_0_2_1",
            "type": "flashcard",
            "question": "Que significa que el opuesto del opuesto sea el mismo numero?",
            "answer": "Significa que $-(-x)=x$ para todo real $x$.",
            "difficulty": "easy"
          },
          {
            "id": "exercise_init_0_2_2",
            "type": "step_by_step",
            "title": "Aplicar regla de signos",
            "steps": [
              {
                "instruction": "Escribe la regla para $x(-y)$.",
                "hint": "Producto por un numero negativo.",
                "answer": "$x(-y)=-(xy)$"
              },
              {
                "instruction": "Ahora calcula $(-3)(-4)$.",
                "hint": "Negativo por negativo da positivo.",
                "answer": "$12$"
              },
              {
                "instruction": "Explica por que el resultado es positivo.",
                "hint": "Usa la regla $(-x)(-y)=xy$.",
                "answer": "Porque el producto de dos negativos es positivo: $(-x)(-y)=xy$."
              }
            ],
            "difficulty": "medium"
          },
          {
            "id": "exercise_init_0_2_3",
            "type": "challenge",
            "title": "Identificar la propiedad",
            "problem": "¿Cuál de las siguientes igualdades ilustra la propiedad distributiva?",
            "options": [
              {
                "value": "$a(b+c)=ab+ac$",
                "correct": true,
                "explanation": "La distributiva del producto sobre la suma."
              },
              {
                "value": "$a+b=b+a$",
                "correct": false,
                "explanation": "Esa es la conmutatividad de la suma."
              },
              {
                "value": "$(a+b)+c=a+(b+c)$",
                "correct": false,
                "explanation": "Esa es la asociatividad de la suma."
              },
              {
                "value": "$a+0=a$",
                "correct": false,
                "explanation": "Esa es la propiedad del elemento neutro aditivo."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exercise_init_0_2_4",
            "type": "flashcard",
            "question": "¿Cuál es el inverso aditivo (opuesto) de $-7$?",
            "answer": "$7$, porque $-7+7=0$. En general, el inverso aditivo de $a$ es $-a$.",
            "difficulty": "easy"
          }
        ],
        "exam": [
          {
            "id": "exam_i0_2_1",
            "question": "¿Cuánto es $(-3)\\times(-4)$?",
            "options": [
              {
                "value": "a",
                "label": "$12$",
                "correct": true,
                "explanation": "Negativo por negativo da positivo: $(-3)\\times(-4)=+12$."
              },
              {
                "value": "b",
                "label": "$-12$",
                "correct": false,
                "explanation": "El producto de dos negativos es positivo."
              },
              {
                "value": "c",
                "label": "$7$",
                "correct": false,
                "explanation": "Eso sería $(-3)+(-4)$."
              },
              {
                "value": "d",
                "label": "$-7$",
                "correct": false,
                "explanation": "Eso sería $(-3)+(-4)=-7$, no el producto."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_2_2",
            "question": "¿Cuál de las propiedades enuncia que $a+b=b+a$?",
            "options": [
              {
                "value": "a",
                "label": "Propiedad conmutativa de la suma",
                "correct": true,
                "explanation": "La conmutatividad dice que el orden de los sumandos no altera la suma."
              },
              {
                "value": "b",
                "label": "Propiedad asociativa",
                "correct": false,
                "explanation": "La asociativa dice $(a+b)+c=a+(b+c)$."
              },
              {
                "value": "c",
                "label": "Propiedad distributiva",
                "correct": false,
                "explanation": "La distributiva dice $a(b+c)=ab+ac$."
              },
              {
                "value": "d",
                "label": "Elemento neutro",
                "correct": false,
                "explanation": "El neutro dice $a+0=a$."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_2_3",
            "question": "¿Cuál es el elemento neutro de la multiplicación en $\\mathbb{R}$?",
            "options": [
              {
                "value": "a",
                "label": "$1$",
                "correct": true,
                "explanation": "$a\\times1=a$ para todo $a\\in\\mathbb{R}$."
              },
              {
                "value": "b",
                "label": "$0$",
                "correct": false,
                "explanation": "$0$ es el neutro de la suma, no de la multiplicación."
              },
              {
                "value": "c",
                "label": "$-1$",
                "correct": false,
                "explanation": "$a\\times(-1)=-a$, no $a$."
              },
              {
                "value": "d",
                "label": "No existe",
                "correct": false,
                "explanation": "El neutro multiplicativo es 1."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_2_4",
            "question": "Si $a=-2$ y $b=5$, ¿cuánto es $a\\cdot b+a\\cdot(-b)$?",
            "options": [
              {
                "value": "a",
                "label": "$0$",
                "correct": true,
                "explanation": "$a(b+(-b))=a\\cdot0=0$. O bien $(-2)(5)+(-2)(-5)=-10+10=0$."
              },
              {
                "value": "b",
                "label": "$-20$",
                "correct": false,
                "explanation": "$(-2)(5)=-10$; el resultado no es $-20$."
              },
              {
                "value": "c",
                "label": "$20$",
                "correct": false,
                "explanation": "La suma de $-10$ y $10$ es $0$, no $20$."
              },
              {
                "value": "d",
                "label": "$-10$",
                "correct": false,
                "explanation": "Solo sería $-10$ si ignoraras el segundo sumando."
              }
            ],
            "difficulty": "medium"
          }
        ]
      }
    },
    {
      "id": "section_init_0_3",
      "title": "Resta y division en R",
      "description": "Define resta como suma con opuesto y division como producto con inverso.",
      "order": 3,
      "content": {
        "theory": {
          "definition": "La diferencia entre $x$ e $y$ se define como $x - y = x + (-y)$. El cociente entre $x$ e $y$ (con $y \\neq 0$) se define como $x/y = x \\cdot y^{-1}$.",
          "examples": [
            {
              "text": "La resta no es conmutativa: $3-5 \\neq 5-3$.",
              "latex": "3-5=-2,\\ 5-3=2"
            },
            {
              "text": "$x-(-y)=x+y$.",
              "latex": "x-(-y)=x+y"
            },
            {
              "text": "La division no es conmutativa: $10/5 \\neq 5/10$.",
              "latex": "10/5=2,\\ 5/10=1/2"
            },
            {
              "text": "Distributiva del cociente respecto de suma y resta ($z \\neq 0$).",
              "latex": "(x+y)/z=x/z+y/z,\\ (x-y)/z=x/z-y/z"
            }
          ],
          "warning": "Error frecuente: en general $x/(y+z)$ no es igual a $x/y + x/z$."
        },
        "para_que_sirve": {
          "title": "Para que sirve",
          "applications": [
            {
              "area": "Manejo de expresiones",
              "description": "Evita errores de signo y de distributiva al operar.",
              "example": "Para quitar parentesis precedidos por menos, cambias el signo de cada termino."
            },
            {
              "area": "Resolucion de problemas",
              "description": "Permite transformar una operacion compleja en pasos equivalentes mas simples.",
              "example": "Convertir una division en multiplicacion por inverso simplifica ecuaciones racionales."
            }
          ]
        },
        "exercises": [
          {
            "id": "exercise_init_0_3_1",
            "type": "challenge",
            "title": "Error de distributiva",
            "problem": "Cual afirmacion es correcta?",
            "options": [
              {
                "value": "$(x+y)/z = x/z + y/z$, con $z \\neq 0$.",
                "correct": true,
                "explanation": "Correcto. Esta es una distributiva valida del cociente respecto de la suma."
              },
              {
                "value": "$x/(y+z) = x/y + x/z$ siempre.",
                "correct": false,
                "explanation": "Incorrecto. Esa igualdad no es valida en general."
              },
              {
                "value": "$x/y = y/x$ para todo $x, y$.",
                "correct": false,
                "explanation": "Incorrecto. La division no es conmutativa."
              }
            ],
            "difficulty": "medium"
          },
          {
            "id": "exercise_init_0_3_2",
            "type": "step_by_step",
            "title": "Resolver una resta con parentesis",
            "steps": [
              {
                "instruction": "Reescribe: $(-2)+5-(1+(-3)+2-(-1+2))$.",
                "hint": "$x-y=x+(-y)$",
                "answer": "$(-2)+5+(-(1+(-3)+2-(-1+2)))$"
              },
              {
                "instruction": "Elimina el parentesis precedido por menos cambiando signos.",
                "hint": "Distribuye el signo menos.",
                "answer": "$(-2)+5-1+3-2+(-1+2)$"
              },
              {
                "instruction": "Suma y simplifica.",
                "hint": "Agrupa positivos y negativos.",
                "answer": "$4$"
              }
            ],
            "difficulty": "hard"
          },
          {
            "id": "exercise_init_0_3_3",
            "type": "flashcard",
            "question": "¿Qué significa restar un número negativo? Enuncia la regla.",
            "answer": "Restar un negativo equivale a sumar su opuesto: $a-(-b)=a+b$.",
            "difficulty": "easy"
          },
          {
            "id": "exercise_init_0_3_4",
            "type": "challenge",
            "title": "Operación con paréntesis",
            "problem": "¿Cuánto es $-3-(2-5)$?",
            "options": [
              {
                "value": "$0$",
                "correct": true,
                "explanation": "$2-5=-3$; luego $-3-(-3)=-3+3=0$."
              },
              {
                "value": "$-10$",
                "correct": false,
                "explanation": "Error: $-(2-5)=+3$, no $-3$."
              },
              {
                "value": "$-6$",
                "correct": false,
                "explanation": "Incorrecto."
              },
              {
                "value": "$4$",
                "correct": false,
                "explanation": "Incorrecto."
              }
            ],
            "difficulty": "easy"
          }
        ],
        "exam": [
          {
            "id": "exam_i0_3_1",
            "question": "¿Cuánto es $5-(-3)$?",
            "options": [
              {
                "value": "a",
                "label": "$8$",
                "correct": true,
                "explanation": "Restar un negativo equivale a sumar: $5-(-3)=5+3=8$."
              },
              {
                "value": "b",
                "label": "$2$",
                "correct": false,
                "explanation": "$2$ sería $5-3$."
              },
              {
                "value": "c",
                "label": "$-8$",
                "correct": false,
                "explanation": "El resultado es positivo."
              },
              {
                "value": "d",
                "label": "$-2$",
                "correct": false,
                "explanation": "Incorrecto."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_3_2",
            "question": "¿Es cierto que $\\frac{a}{b+c}=\\frac{a}{b}+\\frac{a}{c}$?",
            "options": [
              {
                "value": "a",
                "label": "No; por ejemplo $\\frac{6}{2+3}=\\frac{6}{5}$, pero $\\frac{6}{2}+\\frac{6}{3}=5\\neq\\frac{6}{5}$",
                "correct": true,
                "explanation": "Esta igualdad es un error frecuente; la distributiva aplica al numerador, no al denominador."
              },
              {
                "value": "b",
                "label": "Sí, siempre es válido",
                "correct": false,
                "explanation": "No es válido en general."
              },
              {
                "value": "c",
                "label": "Solo es válido cuando $b=c$",
                "correct": false,
                "explanation": "Incluso con $b=c$ sería $\\frac{a}{2b}$ vs $\\frac{a}{b}+\\frac{a}{b}=\\frac{2a}{b}$; no son iguales en general."
              },
              {
                "value": "d",
                "label": "Solo es válido cuando $a=0$",
                "correct": false,
                "explanation": "Si $a=0$, ambos lados son 0, lo cual es trivial pero no representa una propiedad útil."
              }
            ],
            "difficulty": "medium"
          },
          {
            "id": "exam_i0_3_3",
            "question": "Simplifica $(a-b)-(c-d)$.",
            "options": [
              {
                "value": "a",
                "label": "$a-b-c+d$",
                "correct": true,
                "explanation": "Distribuir el signo negativo: $a-b-c+d$."
              },
              {
                "value": "b",
                "label": "$a-b-c-d$",
                "correct": false,
                "explanation": "Error de signo: $-(c-d)=-c+d$, no $-c-d$."
              },
              {
                "value": "c",
                "label": "$a-b+c-d$",
                "correct": false,
                "explanation": "Error de signo: $-(c-d)=-c+d$, no $+c-d$."
              },
              {
                "value": "d",
                "label": "$a+b-c+d$",
                "correct": false,
                "explanation": "Incorrecto."
              }
            ],
            "difficulty": "medium"
          }
        ]
      }
    },
    {
      "id": "section_init_0_4",
      "title": "Potencias con exponente natural o cero",
      "description": "Define x^n para n natural y la convencion x^0=1 con x distinto de 0.",
      "order": 4,
      "content": {
        "theory": {
          "definition": "Si $x$ es real y $n$ es natural mayor que 1, entonces $x^n$ es el producto de $n$ factores iguales a $x$. Ademas, para $x \\neq 0$, se define $x^0=1$. La expresion $0^0$ se considera una indeterminacion en este contexto.",
          "examples": [
            {
              "text": "$x^2=x\\cdot x$, $x^3=x\\cdot x\\cdot x$.",
              "latex": "x^2=x\\cdot x,\\ x^3=x\\cdot x\\cdot x"
            },
            {
              "text": "$2^3=8$ y $2^4=16$.",
              "latex": "2^3=8,\\ 2^4=16"
            },
            {
              "text": "$(-2)^3=-8$ y $(-2)^4=16$.",
              "latex": "(-2)^3=-8,\\ (-2)^4=16"
            },
            {
              "text": "$x^0=1$, con $x \\neq 0$.",
              "latex": "x^0=1,\\ x\\neq 0"
            }
          ]
        },
        "para_que_sirve": {
          "title": "Para que sirve",
          "applications": [
            {
              "area": "Modelos de crecimiento",
              "description": "Las potencias modelan crecimientos repetidos en tiempo discreto.",
              "example": "Interes compuesto: $C_n=C_0(1+r)^n$."
            },
            {
              "area": "Notacion cientifica",
              "description": "Permite representar numeros grandes o pequenos de forma compacta.",
              "example": "$3.2 \\times 10^5 = 320000$."
            }
          ]
        },
        "exercises": [
          {
            "id": "exercise_init_0_4_1",
            "type": "flashcard",
            "question": "Como se define $x^n$ para $n$ natural mayor que 1?",
            "answer": "Como el producto de $n$ factores iguales a $x$: $x^n = \\underbrace{x \\cdot x \\cdots x}_{n}$.",
            "difficulty": "easy"
          },
          {
            "id": "exercise_init_0_4_2",
            "type": "challenge",
            "title": "Evaluar potencias",
            "problem": "Selecciona la opcion correcta.",
            "options": [
              {
                "value": "$(-2)^4=16$ y $(-2)^3=-8$.",
                "correct": true,
                "explanation": "Correcto. Exponente par da positivo; impar conserva signo negativo."
              },
              {
                "value": "$(-2)^4=-16$ y $(-2)^3=8$.",
                "correct": false,
                "explanation": "Incorrecto. Los signos estan invertidos."
              },
              {
                "value": "$0^0=1$ siempre.",
                "correct": false,
                "explanation": "Incorrecto para este curso: $0^0$ se trata como indeterminacion."
              }
            ],
            "difficulty": "medium"
          },
          {
            "id": "exercise_init_0_4_3",
            "type": "step_by_step",
            "title": "Simplificar $(2^3\\times2^2)\\div2^4$",
            "steps": [
              {
                "instruction": "Calcula el numerador: $2^3\\times2^2$.",
                "hint": "Suma los exponentes de la misma base.",
                "answer": "$2^3\\times2^2=2^{3+2}=2^5$."
              },
              {
                "instruction": "Ahora divide: $2^5\\div2^4$.",
                "hint": "Resta los exponentes.",
                "answer": "$2^5\\div2^4=2^{5-4}=2^1=2$."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exercise_init_0_4_4",
            "type": "challenge",
            "title": "Potencia de potencia",
            "problem": "¿Cuánto vale $(3^2)^3$?",
            "options": [
              {
                "value": "$729$",
                "correct": true,
                "explanation": "$(3^2)^3=3^{2\\times3}=3^6=729$."
              },
              {
                "value": "$243$",
                "correct": false,
                "explanation": "$243=3^5$; el exponente es $2\\times3=6$."
              },
              {
                "value": "$81$",
                "correct": false,
                "explanation": "$81=3^4$; el exponente es 6."
              },
              {
                "value": "$36$",
                "correct": false,
                "explanation": "Incorrecto."
              }
            ],
            "difficulty": "easy"
          }
        ],
        "exam": [
          {
            "id": "exam_i0_4_1",
            "question": "¿Cuánto es $7^0$?",
            "options": [
              {
                "value": "a",
                "label": "$1$",
                "correct": true,
                "explanation": "Todo número (distinto de cero) elevado a 0 es 1."
              },
              {
                "value": "b",
                "label": "$0$",
                "correct": false,
                "explanation": "$a^0=1$ para $a\\neq0$."
              },
              {
                "value": "c",
                "label": "$7$",
                "correct": false,
                "explanation": "$7^0=1$, no $7$."
              },
              {
                "value": "d",
                "label": "Indefinido",
                "correct": false,
                "explanation": "$7^0=1$ está perfectamente definido."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_4_2",
            "question": "¿Cuánto es $3^2\\times3^4$?",
            "options": [
              {
                "value": "a",
                "label": "$3^6$",
                "correct": true,
                "explanation": "Al multiplicar potencias de igual base se suman los exponentes: $3^{2+4}=3^6$."
              },
              {
                "value": "b",
                "label": "$3^8$",
                "correct": false,
                "explanation": "$2+4=6$, no 8."
              },
              {
                "value": "c",
                "label": "$9^8$",
                "correct": false,
                "explanation": "La base no cambia; solo se suman los exponentes."
              },
              {
                "value": "d",
                "label": "$3^2$",
                "correct": false,
                "explanation": "Los exponentes se suman, no se dividen."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_4_3",
            "question": "¿Cuánto vale $(2^3)^2$?",
            "options": [
              {
                "value": "a",
                "label": "$64$",
                "correct": true,
                "explanation": "$(2^3)^2=2^{3\\times2}=2^6=64$."
              },
              {
                "value": "b",
                "label": "$12$",
                "correct": false,
                "explanation": "$12=3\\times2\\times2$; no es la potencia correcta."
              },
              {
                "value": "c",
                "label": "$32$",
                "correct": false,
                "explanation": "$2^5=32$; pero el exponente aquí es 6."
              },
              {
                "value": "d",
                "label": "$16$",
                "correct": false,
                "explanation": "$2^4=16$; el exponente es 6."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_4_4",
            "question": "¿Cuál de las igualdades es verdadera?",
            "options": [
              {
                "value": "a",
                "label": "$(2\\cdot5)^3=2^3\\cdot5^3$",
                "correct": true,
                "explanation": "La potencia de un producto es el producto de las potencias: $(ab)^n=a^n b^n$."
              },
              {
                "value": "b",
                "label": "$(2+5)^3=2^3+5^3$",
                "correct": false,
                "explanation": "$(2+5)^3=343$ pero $2^3+5^3=8+125=133$."
              },
              {
                "value": "c",
                "label": "$2^3+2^4=2^7$",
                "correct": false,
                "explanation": "$2^3+2^4=8+16=24\\neq128=2^7$."
              },
              {
                "value": "d",
                "label": "$(2^3)^4=2^{34}$",
                "correct": false,
                "explanation": "$(2^3)^4=2^{3\\times4}=2^{12}$, no $2^{34}$."
              }
            ],
            "difficulty": "medium"
          }
        ]
      }
    },
    {
      "id": "section_init_0_5",
      "title": "Potencias con exponente entero",
      "description": "Extiende la potencia al caso de exponentes negativos y consolida paridad de exponentes.",
      "order": 5,
      "content": {
        "theory": {
          "definition": "Para $a \\geq 0$ y $n$ natural: $(-a)^n = a^n$ si $n$ es par, y $(-a)^n = -(a^n)$ si $n$ es impar. Si $x \\neq 0$ y $n$ es natural, se define $x^{-n} = 1/x^n$.",
          "examples": [
            {
              "text": "Exponente par con base negativa da positivo.",
              "latex": "(-3)^2=9"
            },
            {
              "text": "Exponente impar con base negativa da negativo.",
              "latex": "(-2)^5=-32"
            },
            {
              "text": "Potencia negativa como reciproco.",
              "latex": "2^{-3}=1/2^3=1/8"
            },
            {
              "text": "Con fracciones: elevar a exponente negativo invierte la base.",
              "latex": "(5/3)^{-2}=(3/5)^2=9/25"
            }
          ],
          "properties": [
            "$(p/q)^{-n} = (q/p)^n$, con $p, q \\neq 0$",
            "$x^n \\cdot x^m = x^{n+m}$"
          ]
        },
        "para_que_sirve": {
          "title": "Para que sirve",
          "applications": [
            {
              "area": "Simplificacion algebraica",
              "description": "Permite eliminar exponentes negativos para operar con claridad.",
              "example": "$a^{-3}$ se transforma en $1/a^3$ antes de combinar terminos."
            },
            {
              "area": "Modelos inversos",
              "description": "Aparece en leyes donde una magnitud decrece como potencia inversa.",
              "example": "Intensidad proporcional a $r^{-2}$."
            }
          ]
        },
        "exercises": [
          {
            "id": "exercise_init_0_5_1",
            "type": "challenge",
            "title": "Paridad de exponente",
            "problem": "Cual afirmacion es correcta?",
            "options": [
              {
                "value": "$(-1)^{180}=1$ y $(-1)^{175}=-1$.",
                "correct": true,
                "explanation": "Correcto. Solo importa si el exponente es par o impar."
              },
              {
                "value": "$(-1)^{180}=-1$ porque la base es negativa.",
                "correct": false,
                "explanation": "Incorrecto. Exponente par produce resultado positivo."
              },
              {
                "value": "$(-2)^5=32$.",
                "correct": false,
                "explanation": "Incorrecto. Exponente impar conserva signo negativo: $(-2)^5=-32$."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exercise_init_0_5_2",
            "type": "step_by_step",
            "title": "Calcular potencias enteras",
            "steps": [
              {
                "instruction": "Reescribe $2^{-3}$ usando la definicion de exponente negativo.",
                "hint": "$x^{-n}=1/x^n$",
                "answer": "$2^{-3}=1/2^3$"
              },
              {
                "instruction": "Evalua el denominador.",
                "hint": "$2^3=8$",
                "answer": "$1/8$"
              },
              {
                "instruction": "Ahora calcula $(-3)^{-2}$.",
                "hint": "Primero invierte, luego eleva al cuadrado.",
                "answer": "$(-3)^{-2}=1/(-3)^2=1/9$"
              }
            ],
            "difficulty": "medium"
          },
          {
            "id": "exercise_init_0_5_3",
            "type": "flashcard",
            "question": "Regla de signo para potencias de base negativa: ¿cuándo el resultado es positivo y cuándo negativo?",
            "answer": "Con exponente **par**: $(-a)^{\\text{par}}>0$ (p. ej. $(-2)^4=16$). Con exponente **impar**: $(-a)^{\\text{impar}}<0$ (p. ej. $(-2)^3=-8$).",
            "difficulty": "easy"
          },
          {
            "id": "exercise_init_0_5_4",
            "type": "challenge",
            "title": "Ordenar potencias",
            "problem": "Ordena de menor a mayor: $2^{-3},\\;2^{-1},\\;2^0,\\;2^1$.",
            "options": [
              {
                "value": "$2^{-3}<2^{-1}<2^0<2^1$",
                "correct": true,
                "explanation": "$\\frac{1}{8}<\\frac{1}{2}<1<2$."
              },
              {
                "value": "$2^{-3}<2^0<2^{-1}<2^1$",
                "correct": false,
                "explanation": "$2^0=1>\\frac{1}{2}=2^{-1}$."
              },
              {
                "value": "$2^1<2^0<2^{-1}<2^{-3}$",
                "correct": false,
                "explanation": "El orden es el inverso."
              },
              {
                "value": "$2^{-1}<2^{-3}<2^0<2^1$",
                "correct": false,
                "explanation": "$2^{-3}=\\frac{1}{8}<\\frac{1}{2}=2^{-1}$."
              }
            ],
            "difficulty": "medium"
          }
        ],
        "exam": [
          {
            "id": "exam_i0_5_1",
            "question": "¿Cuánto vale $5^{-2}$?",
            "options": [
              {
                "value": "a",
                "label": "$\\frac{1}{25}$",
                "correct": true,
                "explanation": "$a^{-n}=\\frac{1}{a^n}$; $5^{-2}=\\frac{1}{5^2}=\\frac{1}{25}$."
              },
              {
                "value": "b",
                "label": "$-25$",
                "correct": false,
                "explanation": "El exponente negativo invierte la base, no la niega."
              },
              {
                "value": "c",
                "label": "$-10$",
                "correct": false,
                "explanation": "Incorrecto."
              },
              {
                "value": "d",
                "label": "$\\frac{1}{10}$",
                "correct": false,
                "explanation": "$5^{-2}=\\frac{1}{25}$, no $\\frac{1}{10}$."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_5_2",
            "question": "Simplifica $\\dfrac{3^5}{3^3}$.",
            "options": [
              {
                "value": "a",
                "label": "$9$",
                "correct": true,
                "explanation": "$\\frac{3^5}{3^3}=3^{5-3}=3^2=9$."
              },
              {
                "value": "b",
                "label": "$3^{15}$",
                "correct": false,
                "explanation": "Al dividir potencias iguales se restan los exponentes."
              },
              {
                "value": "c",
                "label": "$1$",
                "correct": false,
                "explanation": "$1$ solo si los exponentes fueran iguales."
              },
              {
                "value": "d",
                "label": "$3$",
                "correct": false,
                "explanation": "$3^{5-3}=3^2=9$, no $3^1=3$."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_5_3",
            "question": "¿Es cierto que $(-2)^3=-8$?",
            "options": [
              {
                "value": "a",
                "label": "Sí, porque $(-2)^3=(-2)(-2)(-2)=-8$",
                "correct": true,
                "explanation": "El producto de tres factores negativos es negativo."
              },
              {
                "value": "b",
                "label": "No, toda potencia es positiva",
                "correct": false,
                "explanation": "Las potencias de exponente impar de bases negativas son negativas."
              },
              {
                "value": "c",
                "label": "No, $(-2)^3=2^3=8$",
                "correct": false,
                "explanation": "El signo negativo de la base importa cuando el exponente es impar."
              },
              {
                "value": "d",
                "label": "Depende del contexto",
                "correct": false,
                "explanation": "$(-2)^3=-8$ siempre."
              }
            ],
            "difficulty": "easy"
          },
          {
            "id": "exam_i0_5_4",
            "question": "¿Cuánto vale $\\left(\\dfrac{2}{3}\\right)^{-2}$?",
            "options": [
              {
                "value": "a",
                "label": "$\\dfrac{9}{4}$",
                "correct": true,
                "explanation": "$\\left(\\frac{2}{3}\\right)^{-2}=\\left(\\frac{3}{2}\\right)^2=\\frac{9}{4}$."
              },
              {
                "value": "b",
                "label": "$\\dfrac{4}{9}$",
                "correct": false,
                "explanation": "Eso sería $\\left(\\frac{2}{3}\\right)^{2}$."
              },
              {
                "value": "c",
                "label": "$-\\dfrac{4}{9}$",
                "correct": false,
                "explanation": "El exponente $-2$ es par; el resultado es positivo."
              },
              {
                "value": "d",
                "label": "$\\dfrac{1}{4}$",
                "correct": false,
                "explanation": "Incorrecto."
              }
            ],
            "difficulty": "medium"
          }
        ]
      }
    }
  ]
}